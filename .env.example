# ── Required ──────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=          # Claude API key (claude-sonnet model)
DATAFORSEO_LOGIN=           # DataForSEO account email
DATAFORSEO_PASSWORD=        # DataForSEO account password

# ── Optional — skip silently if not set ───────────────────────────────────────

SEMRUSH_API_KEY=            # SEMrush Standard API key (Pro plan or above)
PINGCAP_DOMAIN=pingcap.com  # Domain used for PingCAP URL checks
PINGCAP_SITEMAP_URL=https://www.pingcap.com/sitemap_index.xml
SITEMAP_INVENTORY_FILE=     # Optional path; defaults to sitemap_inventory.json beside brief.py

# ── Google OAuth — required only for Save to Google Docs output ───────────────

# Generate credentials.json from Google Cloud Console (OAuth 2.0 Desktop client)

# Run the script once locally to generate token.json via browser auth flow

# Both files must sit alongside brief.py in the same directory

# ── Model selection — override defaults ───────────────────────────────────────

ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Maximum output tokens for brief generation (title generation stays at 50)
ANTHROPIC_MAX_TOKENS=16000

# Optional Google Drive destination (local or hosted)
DRIVE_FOLDER_ID=

# ── Railway / hosted deployment only ─────────────────────────────────────────

# TOKEN_JSON_B64=           # base64-encoded contents of token.json

# CREDENTIALS_JSON_B64=     # base64-encoded contents of credentials.json



