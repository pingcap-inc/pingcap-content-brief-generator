# ── Required ──────────────────────────────────────────────────────────────────

ANTHROPIC\_API\_KEY=          # Claude API key (claude-sonnet model)
DATAFORSEO\_LOGIN=           # DataForSEO account email
DATAFORSEO\_PASSWORD=        # DataForSEO account password

# ── Optional — skip silently if not set ───────────────────────────────────────

SEMRUSH\_API\_KEY=            # SEMrush Standard API key (Pro plan or above)
PINGCAP\_DOMAIN=pingcap.com  # Domain used for PingCAP URL checks
PINGCAP_SITEMAP_URL=https://www.pingcap.com/sitemap_index.xml
SITEMAP_INVENTORY_FILE=     # Optional path; defaults to sitemap_inventory.json beside brief.py

# ── Google OAuth — required only for Save to Google Docs output ───────────────

# Generate credentials.json from Google Cloud Console (OAuth 2.0 Desktop client)

# Run the script once locally to generate token.json via browser auth flow

# Both files must sit alongside brief.py in the same directory

# ── Model selection — override defaults ───────────────────────────────────────

ANTHROPIC\_MODEL=claude-sonnet-4-20250514
ANTHROPIC\_HAIKU\_MODEL=claude-haiku-4-5-20251001

# ── Railway / hosted deployment only ─────────────────────────────────────────

# TOKEN\_JSON\_B64=           # base64-encoded contents of token.json

# CREDENTIALS\_JSON\_B64=     # base64-encoded contents of credentials.json

# DRIVE\_FOLDER\_ID=          # Google Drive folder ID to save briefs into
